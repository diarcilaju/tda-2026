<%- include('partials/cabecera') %>

<div class="barra">
    <h2>Listado de Productos</h2>
    <a href="/productos/nuevo" class="boton">Nuevo Producto</a>
</div>

<% if (productos.length > 0) { %>
    <p>Aún no hay productos registrados.</p>
<% } else { %>
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Precio</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            <% productos.forEach(producto => { %>
                <tr>
                    <td><%= producto.id %></td>
                    <td><%= producto.nombre %></td>
                    <td><%= producto.precio %></td>
                    <td>
                        <a href="/productos/editar/<%= producto.id %>" class="boton">Editar</a>
                        <form action="/productos/eliminar/<%= producto.id %>" method="POST" style="display:inline;">
                            <button type="submit" class="boton">Eliminar</button>
                        </form>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
    <% } %>
    <%- include('partials/pie') %>